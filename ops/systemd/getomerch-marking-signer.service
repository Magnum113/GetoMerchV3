[Unit]
Description=GetoMerch isolated UKEP marking signer

[Service]
Type=simple
User=getomerch-signer
Group=getomerch-marking
WorkingDirectory=/opt/getomerch/current
EnvironmentFile=/etc/getomerch/marking-production.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--conditions=react-server
ExecStart=/usr/bin/npm run marking:signer
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RuntimeDirectory=getomerch-marking
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/getomerch-marking
ReadOnlyPaths=-/var/opt/cprocsp
BindReadOnlyPaths=-/run/pcscd/pcscd.comm
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
IPAddressDeny=any
UMask=0077

[Install]
WantedBy=multi-user.target
