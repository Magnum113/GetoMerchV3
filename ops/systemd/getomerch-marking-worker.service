[Unit]
Description=GetoMerch isolated marking worker
After=postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=getomerch-marking
Group=getomerch-marking
WorkingDirectory=/opt/getomerch/current
EnvironmentFile=/etc/getomerch/marking-production.env
EnvironmentFile=/etc/getomerch/marking-database.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--conditions=react-server
ExecStart=/usr/bin/npm run marking:worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
IPAddressDeny=any
UMask=0077

[Install]
WantedBy=multi-user.target
