[Unit]
Description=GetoMerch expired marking import cleanup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=getomerch
Group=getomerch
WorkingDirectory=/opt/getomerch/current
EnvironmentFile=/etc/getomerch/admin-production.env
EnvironmentFile=/etc/getomerch/database.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--conditions=react-server
Environment=GETOMERCH_DATABASE_POOL_MAX=1
Environment=GETOMERCH_DATABASE_APPLICATION_NAME=getomerch-marking-import-scrub
ExecStart=/usr/bin/npm run marking:imports:scrub
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
