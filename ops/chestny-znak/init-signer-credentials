#!/usr/bin/env bash
set -Eeuo pipefail

TARGET_DIR="${GETOMERCH_CREDENTIALS_DIRECTORY:-/etc/getomerch/credentials}"
CLIENT_ID="${GETOMERCH_MARKING_SIGNER_CLIENT_ID:-marking-worker}"
ROTATE="${GETOMERCH_ROTATE_SIGNER_CLIENT_SECRET:-false}"
CLIENT_SECRET_FILE="$TARGET_DIR/marking-signer-client-secret"
CLIENTS_FILE="$TARGET_DIR/marking-signer-clients.json"

[[ "$CLIENT_ID" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || {
  echo "Invalid signer client ID" >&2
  exit 1
}
install -d -m 0700 -o root -g root "$TARGET_DIR"
if [[ -e "$CLIENT_SECRET_FILE" || -e "$CLIENTS_FILE" ]]; then
  if [[ "$ROTATE" != true ]]; then
    echo "Signer credentials already exist; set GETOMERCH_ROTATE_SIGNER_CLIENT_SECRET=true to rotate" >&2
    exit 1
  fi
fi

umask 077
secret="$(openssl rand -base64 32 | tr -d '\n')"
secret_tmp="$(mktemp "$TARGET_DIR/.marking-signer-client-secret.XXXXXX")"
clients_tmp="$(mktemp "$TARGET_DIR/.marking-signer-clients.XXXXXX")"
cleanup() {
  rm -f "$secret_tmp" "$clients_tmp"
  unset secret
}
trap cleanup EXIT
printf '%s\n' "$secret" > "$secret_tmp"
printf '{"clients":{"%s":"%s"}}\n' "$CLIENT_ID" "$secret" > "$clients_tmp"
chmod 0600 "$secret_tmp" "$clients_tmp"
chown root:root "$secret_tmp" "$clients_tmp"
mv -f "$secret_tmp" "$CLIENT_SECRET_FILE"
mv -f "$clients_tmp" "$CLIENTS_FILE"
echo "Signer client credentials installed in $TARGET_DIR"
