#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

CONFIG_DIR="${1:-$HOME/.config/getomerch-marking}"
AGENT_ID="${GETOMERCH_MARKING_AGENT_ID:-macbook-marking}"
CLIENT_ID="${GETOMERCH_MARKING_SIGNER_CLIENT_ID:-marking-mac-agent}"

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

[[ "$AGENT_ID" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || fail "invalid agent ID"
[[ "$CLIENT_ID" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || fail "invalid signer client ID"
command -v openssl >/dev/null 2>&1 || fail "openssl is required"

mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"

for path in \
  "$CONFIG_DIR/agent-secret" \
  "$CONFIG_DIR/server-agent-secrets.json" \
  "$CONFIG_DIR/signer-client-secret" \
  "$CONFIG_DIR/signer-clients.json"; do
  [[ ! -e "$path" ]] || fail "refusing to overwrite $path"
done

agent_secret="$(openssl rand -base64 48 | tr -d '\n')"
signer_secret="$(openssl rand -base64 48 | tr -d '\n')"

printf '%s\n' "$agent_secret" >"$CONFIG_DIR/agent-secret"
printf '{\n  "version": 1,\n  "agents": {\n    "%s": "%s"\n  }\n}\n' \
  "$AGENT_ID" "$agent_secret" >"$CONFIG_DIR/server-agent-secrets.json"
printf '%s\n' "$signer_secret" >"$CONFIG_DIR/signer-client-secret"
printf '{\n  "version": 1,\n  "clients": {\n    "%s": "%s"\n  }\n}\n' \
  "$CLIENT_ID" "$signer_secret" >"$CONFIG_DIR/signer-clients.json"

unset agent_secret signer_secret
chmod 600 \
  "$CONFIG_DIR/agent-secret" \
  "$CONFIG_DIR/server-agent-secrets.json" \
  "$CONFIG_DIR/signer-client-secret" \
  "$CONFIG_DIR/signer-clients.json"

printf 'Credentials created in %s\n' "$CONFIG_DIR"
printf 'Install server-agent-secrets.json on the VPS as marking-agent-secrets.json.\n'
printf 'No secret values were printed. certificate.json and the env file are still required.\n'
