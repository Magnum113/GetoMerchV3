# Reviewed defaults for the first GetoMerch production database cutover.
GETOMERCH_CUTOVER_APPROVED=true
GETOMERCH_CUTOVER_WINDOW_MINUTES=60
GETOMERCH_CUTOVER_RPO_MINUTES=60
GETOMERCH_CUTOVER_SUPABASE_RETENTION_DAYS=30
GETOMERCH_CUTOVER_AUTOMATION_DELAY_HOURS=24
GETOMERCH_CUTOVER_ROLLBACK_BOUNDARY=before_first_write
