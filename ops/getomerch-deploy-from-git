#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  sudo /usr/local/sbin/getomerch-deploy-from-git prod [branch]

Builds GetoMerch admin from origin/<branch>, creates an immutable release,
activates /opt/getomerch/current, restarts getomerch-admin.service, runs smoke
checks, and appends an event to /var/lib/getomerch/deploy-registry.jsonl.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run with sudo." >&2
  exit 1
fi

target="${1:-}"
branch="${2:-main}"
case "$target" in
  prod) ;;
  *)
    usage >&2
    exit 1
    ;;
esac

repo_url="${GETOMERCH_DEPLOY_REPO_URL:-https://github.com/Magnum113/GetoMerchV3.git}"
base_dir="${GETOMERCH_BASE_DIR:-/opt/getomerch}"
source_dir="${GETOMERCH_DEPLOY_SOURCE_DIR:-$base_dir/deploy-source}"
build_dir="${GETOMERCH_BUILD_DIR:-$base_dir/build-source}"
releases_dir="${GETOMERCH_RELEASES_DIR:-$base_dir/releases}"
current_link="${GETOMERCH_CURRENT_LINK:-$base_dir/current}"
service_unit="${GETOMERCH_SERVICE_UNIT:-getomerch-admin.service}"
worker_unit="${GETOMERCH_WORKER_UNIT:-getomerch-worker.service}"
log_dir="${GETOMERCH_DEPLOY_LOG_DIR:-/var/log/getomerch/deploy}"
registry_path="${GETOMERCH_DEPLOY_REGISTRY:-/var/lib/getomerch/deploy-registry.jsonl}"
current_state_path="${GETOMERCH_DEPLOY_CURRENT:-/var/lib/getomerch/deploy-current.json}"
lock_path="${GETOMERCH_DEPLOY_LOCK_PATH:-/run/getomerch-admin-deploy.lock}"
npm_cache_dir="${GETOMERCH_NPM_CACHE_DIR:-/var/cache/getomerch/npm}"
deploy_home="${GETOMERCH_DEPLOY_HOME:-/var/lib/getomerch/deploy-home}"
production_env_file="${GETOMERCH_PRODUCTION_ENV_FILE:-/etc/getomerch/admin-production.env}"
min_free_mb="${GETOMERCH_MIN_FREE_MB:-2048}"
keep_recent_successful="${GETOMERCH_KEEP_RECENT_SUCCESSFUL:-2}"
npm_cache_max_mb="${GETOMERCH_NPM_CACHE_MAX_MB:-1024}"
run_id="$(date -u +%Y%m%dT%H%M%SZ)"
log_file="$log_dir/${run_id}-${target}.log"

install -d -m 0755 "$base_dir" "$releases_dir" "$log_dir" "$(dirname "$registry_path")" "$npm_cache_dir" "$deploy_home"
exec > >(tee -a "$log_file") 2>&1

export HOME="$deploy_home"
export npm_config_cache="$npm_cache_dir"
export NPM_CONFIG_CACHE="$npm_cache_dir"
export NEXT_TELEMETRY_DISABLED=1

previous_current=""
previous_release=""
release=""
release_dir=""
commit=""
checks=""
activated=0

log() {
  printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"
}

fail() {
  log "ERROR: $*"
  exit 1
}

add_check() {
  checks="${checks}${checks:+$'\n'}$*"
}

disk_free_mb() {
  df -Pm "$base_dir" | awk 'NR == 2 { print $4 }'
}

dir_size_mb() {
  local dir="$1"
  if [[ -e "$dir" ]]; then
    du -sm "$dir" 2>/dev/null | awk '{ print $1 }'
  else
    printf '0\n'
  fi
}

assert_disk_space() {
  local context="$1"
  local free_mb
  free_mb="$(disk_free_mb)"
  log "disk free before $context: ${free_mb}MiB (min ${min_free_mb}MiB)"
  if (( free_mb < min_free_mb )); then
    fail "not enough disk space before $context: ${free_mb}MiB free, need at least ${min_free_mb}MiB"
  fi
}

cleanup_stale_artifacts() {
  log "cleaning stale deploy artifacts"
  rm -rf "$build_dir"
  find "$releases_dir" -maxdepth 1 -mindepth 1 -type d -name '*.tmp' -print -exec rm -rf {} +
}

cleanup_npm_cache() {
  local cache_mb
  cache_mb="$(dir_size_mb "$npm_cache_dir")"
  log "npm cache size: ${cache_mb}MiB (max ${npm_cache_max_mb}MiB)"
  find "$npm_cache_dir" "$deploy_home/.npm" -path '*/_logs/*' -type f -mtime +7 -delete 2>/dev/null || true
  if (( cache_mb > npm_cache_max_mb )); then
    log "cleaning npm cache because it exceeds ${npm_cache_max_mb}MiB"
    npm --cache "$npm_cache_dir" cache clean --force
  fi
}

cleanup_old_releases() {
  log "cleaning old releases with retention"
  RELEASES_DIR="$releases_dir" \
  CURRENT_LINK="$current_link" \
  REGISTRY_PATH="$registry_path" \
  PREVIOUS_CURRENT="$previous_current" \
  KEEP_RECENT_SUCCESSFUL="$keep_recent_successful" \
  python3 - <<'PY'
import json
import os
import shutil
from pathlib import Path

releases_dir = Path(os.environ["RELEASES_DIR"]).resolve()
current_link = Path(os.environ["CURRENT_LINK"])
registry_path = Path(os.environ["REGISTRY_PATH"])
previous_current = os.environ.get("PREVIOUS_CURRENT", "")
keep_recent = int(os.environ.get("KEEP_RECENT_SUCCESSFUL", "2") or "2")

keep = set()

def add_keep(path):
    if not path:
        return
    try:
        resolved = Path(path).resolve()
    except FileNotFoundError:
        return
    if resolved.exists() and resolved.parent == releases_dir:
        keep.add(resolved)

if current_link.exists():
    add_keep(current_link)
add_keep(previous_current)

events = []
if registry_path.exists():
    for raw in registry_path.read_text(encoding="utf-8").splitlines():
        raw = raw.strip()
        if not raw:
            continue
        try:
            event = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if event.get("status") == "success":
            events.append(event)

for event in reversed(events):
    add_keep(event.get("releasePath") or "")
    if len(keep) >= keep_recent + 2:
        break

for candidate in releases_dir.iterdir():
    if not candidate.is_dir():
        continue
    if (candidate / ".getomerch-keep").exists() or (candidate / "KEEP_RELEASE").exists():
        keep.add(candidate.resolve())

removed = []
kept = []
for candidate in sorted(releases_dir.iterdir(), key=lambda p: p.stat().st_mtime):
    if not candidate.is_dir():
        continue
    resolved = candidate.resolve()
    if resolved.parent != releases_dir:
        print(f"skip unsafe {candidate}")
        continue
    if resolved in keep:
        kept.append(candidate.name)
        continue
    if "-admin-" not in candidate.name:
        print(f"skip non-admin release {candidate.name}")
        continue
    shutil.rmtree(candidate)
    removed.append(candidate.name)

print(f"release retention kept={len(kept)} removed={len(removed)}")
for name in kept:
    print(f"keep release {name}")
for name in removed:
    print(f"removed release {name}")
PY
}

read_env_var() {
  local key="$1"
  node - "$production_env_file" "$key" <<'NODE'
const fs = require("fs");

const [, , file, key] = process.argv;
const text = fs.readFileSync(file, "utf8");

for (const raw of text.split(/\r?\n/)) {
  const line = raw.trim();
  if (!line || line.startsWith("#")) continue;
  const idx = line.indexOf("=");
  if (idx === -1) continue;
  const name = line.slice(0, idx).trim().replace(/^export\s+/, "");
  if (name !== key) continue;

  let value = line.slice(idx + 1).trim();
  const quote = value[0];
  if ((quote === '"' || quote === "'") && value.endsWith(quote)) {
    value = value.slice(1, -1);
  }
  process.stdout.write(value);
  process.exit(0);
}

process.exit(2);
NODE
}

load_public_build_env() {
  [[ -r "$production_env_file" ]] || fail "production env file is not readable: $production_env_file"

  local supabase_url
  local supabase_anon_key
  supabase_url="$(read_env_var NEXT_PUBLIC_SUPABASE_URL)" || fail "NEXT_PUBLIC_SUPABASE_URL is missing in $production_env_file"
  supabase_anon_key="$(read_env_var NEXT_PUBLIC_SUPABASE_ANON_KEY)" || fail "NEXT_PUBLIC_SUPABASE_ANON_KEY is missing in $production_env_file"

  [[ "$supabase_url" =~ ^https://[a-z0-9-]+\.supabase\.co$ ]] || fail "NEXT_PUBLIC_SUPABASE_URL has unexpected format"
  [[ "$supabase_anon_key" =~ ^[A-Za-z0-9._-]{20,}$ ]] || fail "NEXT_PUBLIC_SUPABASE_ANON_KEY has unexpected format"

  export NEXT_PUBLIC_SUPABASE_URL="$supabase_url"
  export NEXT_PUBLIC_SUPABASE_ANON_KEY="$supabase_anon_key"
  log "loaded public Supabase build env from $production_env_file"
}

assert_client_supabase_config() {
  node <<'NODE'
const fs = require("fs");
const path = require("path");

const root = path.join(process.cwd(), ".next", "static");
const forbiddenNames = [
  "ADMIN_AUTH_COOKIE_SECRET",
  "ADMIN_AUTH_PASSWORD_HASH",
  "KOMUI_ADMIN_API_TOKEN",
  "KOMUI_PROD_ADMIN_API_TOKEN",
  "KOMUI_STAGE_ADMIN_API_TOKEN",
  "KOMUI_STAGE_BASIC_AUTH",
  "OZON_API_KEY",
  "PERFORMANCE_CLIENT_SECRET",
  "GETOMERCH_DATABASE_URL",
  "GETOMERCH_MIGRATOR_DATABASE_URL",
  "GETOMERCH_BACKUP_DATABASE_URL",
  "GETOMERCH_SUPABASE_DATABASE_URL",
  "GETOMERCH_SUPABASE_SERVICE_ROLE_KEY",
  "GETOMERCH_SUPABASE_SERVER_KEY",
  "GETOMERCH_INTERNAL_SERVICE_TOKEN",
  "SUPABASE_SERVICE_ROLE_KEY",
  "SUPABASE_SERVICE_ROLE",
  "SUPABASE_SERVER_KEY",
];

if (!fs.existsSync(root)) {
  throw new Error(".next/static was not created");
}

const leakedNames = new Set();

function scan(dir) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      scan(full);
      continue;
    }
    if (!/\.(js|html|json|txt|css)$/.test(entry.name)) continue;
    const content = fs.readFileSync(full, "utf8");
    for (const name of forbiddenNames) {
      if (content.includes(name)) leakedNames.add(name);
    }
  }
}

scan(root);

if (leakedNames.size > 0) {
  throw new Error(`server-only env names leaked into client assets: ${Array.from(leakedNames).join(", ")}`);
}
NODE
}

smoke_supabase_readonly() {
  node <<'NODE'
const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
const anon = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;

if (!url || !anon) {
  throw new Error("public Supabase env is not loaded");
}

const endpoint = `${url.replace(/\/$/, "")}/rest/v1/merch_ozon_orders?select=id&limit=1`;

fetch(endpoint, {
  headers: {
    apikey: anon,
    Authorization: `Bearer ${anon}`,
    Accept: "application/json",
  },
}).then(async (response) => {
  if (!response.ok) {
    const text = await response.text().catch(() => "");
    throw new Error(`Supabase read-only smoke failed with ${response.status}: ${text.slice(0, 160)}`);
  }
}).catch((error) => {
  console.error(error.message || error);
  process.exit(1);
});
NODE
}

record_event() {
  local status="$1"
  local summary="$2"
  EVENT_STATUS="$status" \
  EVENT_SUMMARY="$summary" \
  EVENT_TARGET="$target" \
  EVENT_BRANCH="$branch" \
  EVENT_RELEASE="$release" \
  EVENT_RELEASE_PATH="$release_dir" \
  EVENT_PREVIOUS_RELEASE="$previous_release" \
  EVENT_GIT_COMMIT="$commit" \
  EVENT_LOG_PATH="$log_file" \
  EVENT_CHECKS="$checks" \
  EVENT_REGISTRY="$registry_path" \
  EVENT_CURRENT="$current_state_path" \
  EVENT_SERVICE="$service_unit" \
  EVENT_CURRENT_LINK="$current_link" \
  python3 - <<'PY'
import fcntl
import json
import os
import socket
import subprocess
import uuid
from datetime import datetime, timezone
from pathlib import Path


def utc_now():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def run_text(args):
    try:
        return subprocess.check_output(args, stderr=subprocess.DEVNULL, text=True).strip()
    except Exception:
        return ""


registry = Path(os.environ["EVENT_REGISTRY"])
current_file = Path(os.environ["EVENT_CURRENT"])
current_link = Path(os.environ["EVENT_CURRENT_LINK"])
service = os.environ["EVENT_SERVICE"]
active_path = run_text(["readlink", "-f", str(current_link)])
active_release = Path(active_path).name if active_path else ""
service_state = run_text(["systemctl", "is-active", service]) or "unknown"
checks = [line for line in os.environ.get("EVENT_CHECKS", "").splitlines() if line.strip()]
event = {
    "id": str(uuid.uuid4()),
    "timestamp": utc_now(),
    "host": socket.getfqdn() or socket.gethostname(),
    "actor": os.environ.get("SUDO_USER") or os.environ.get("USER") or "",
    "event": "deploy",
    "component": "admin",
    "status": os.environ["EVENT_STATUS"],
    "target": os.environ["EVENT_TARGET"],
    "branch": os.environ["EVENT_BRANCH"],
    "release": os.environ.get("EVENT_RELEASE", ""),
    "releasePath": os.environ.get("EVENT_RELEASE_PATH", ""),
    "previousRelease": os.environ.get("EVENT_PREVIOUS_RELEASE", ""),
    "gitCommit": os.environ.get("EVENT_GIT_COMMIT", ""),
    "summary": os.environ["EVENT_SUMMARY"],
    "checks": checks,
    "logPath": os.environ["EVENT_LOG_PATH"],
    "active": {
        "release": active_release,
        "path": active_path,
    },
    "services": {
        service: service_state,
        "nginx": run_text(["systemctl", "is-active", "nginx"]) or "unknown",
    },
}

registry.parent.mkdir(parents=True, exist_ok=True)
current_file.parent.mkdir(parents=True, exist_ok=True)
lock_path = registry.with_suffix(registry.suffix + ".lock")
with lock_path.open("a+") as lock:
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    with registry.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(event, ensure_ascii=False, separators=(",", ":")) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    snapshot = {
        "updatedAt": event["timestamp"],
        "active": event["active"],
        "lastEvent": event,
    }
    tmp = current_file.with_suffix(current_file.suffix + ".tmp")
    tmp.write_text(json.dumps(snapshot, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, current_file)
    os.chmod(registry, 0o644)
    os.chmod(current_file, 0o644)
PY
}

rollback_previous() {
  if [[ "$activated" == "1" && -n "$previous_current" && -d "$previous_current" ]]; then
    log "restoring previous release $previous_current"
    ln -sfnT "$previous_current" "$current_link"
    systemctl restart "$service_unit" || true
    if systemctl is-enabled --quiet "$worker_unit" 2>/dev/null; then
      systemctl restart "$worker_unit" || true
    fi
  fi
}

on_error() {
  local rc="$1"
  local line="$2"
  trap - ERR
  log "ERROR: deploy failed at line $line with exit code $rc"
  rollback_previous
  record_event "failure" "Deploy failed at line $line with exit code $rc"
  rm -rf "$build_dir"
  if [[ -n "$release_dir" ]]; then
    rm -rf "${release_dir}.tmp"
  fi
  exit "$rc"
}

trap 'on_error "$?" "$LINENO"' ERR

exec 9>"$lock_path"
flock -n 9 || {
  log "ERROR: another GetoMerch admin deploy is already running"
  exit 1
}

log "target=$target"
log "branch=$branch"
log "repo=$repo_url"
log "log=$log_file"

previous_current="$(readlink -f "$current_link" 2>/dev/null || true)"
previous_release="$(basename "$previous_current" 2>/dev/null || true)"
log "previous_current=${previous_current:-none}"

cleanup_stale_artifacts
assert_disk_space "source checkout and npm ci"

if [[ ! -d "$source_dir/.git" ]]; then
  log "cloning source into $source_dir"
  rm -rf "$source_dir"
  git clone --branch "$branch" "$repo_url" "$source_dir"
fi

cd "$source_dir"
git remote set-url origin "$repo_url"
git fetch --prune origin "$branch"
git checkout -f -B "$branch" "origin/$branch"
git reset --hard "origin/$branch"
source_real="$(readlink -f "$source_dir")"
if [[ "$previous_current" == "$source_real" ]]; then
  # Keep runtime artifacts while the first production service still points at deploy-source.
  git clean -ffd -e node_modules -e .next
else
  git clean -ffdx
fi

commit="$(git rev-parse HEAD)"
short_commit="${commit:0:12}"
release="${run_id}-admin-${short_commit}"
release_dir="$releases_dir/$release"
log "git_commit=$commit"
log "release=$release"

log "preparing disposable build dir $build_dir"
install -d -m 0755 "$build_dir"
rsync -a --delete \
  --exclude '.git' \
  --exclude 'node_modules' \
  --exclude '.next' \
  "$source_dir/" "$build_dir/"

cd "$build_dir"
log "installing dependencies"
assert_disk_space "npm ci"
npm ci

load_public_build_env

log "building Next.js admin"
npm run build
add_check "npm run build"

log "checking client assets for server-only env leaks"
assert_client_supabase_config
add_check "client assets do not contain server-only env names"

log "checking Supabase read-only access"
smoke_supabase_readonly
add_check "Supabase read-only smoke"

log "creating release $release_dir"
assert_disk_space "release creation"
rm -rf "${release_dir}.tmp" "$release_dir"
install -d -m 0755 "${release_dir}.tmp"
rsync -a --delete \
  --exclude 'node_modules' \
  --exclude '.git' \
  --exclude '.next/cache' \
  "$build_dir/" "${release_dir}.tmp/"

log "installing production dependencies in release"
assert_disk_space "production dependency install"
npm --prefix "${release_dir}.tmp" ci --omit=dev

mv "${release_dir}.tmp" "$release_dir"
chown -R root:root "$release_dir"

log "activating release"
ln -sfnT "$release_dir" "$current_link"
activated=1
systemctl restart "$service_unit"
if systemctl is-enabled --quiet "$worker_unit" 2>/dev/null; then
  systemctl restart "$worker_unit"
  add_check "$worker_unit restarted"
fi

log "waiting for service"
for _ in $(seq 1 30); do
  if systemctl is-active --quiet "$service_unit" && curl -fsS --max-time 3 http://127.0.0.1:3100/login >/dev/null; then
    break
  fi
  sleep 1
done
curl -fsS --max-time 5 http://127.0.0.1:3100/login >/dev/null
add_check "local /login 200"

api_code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:3100/api/komui/runtime)"
[[ "$api_code" == "401" ]]
add_check "local protected API without cookie 401"

redirect_url="$(curl -sS -o /dev/null -w '%{redirect_url}' --max-time 10 https://admin.komui.ru/)"
[[ "$redirect_url" == "https://admin.komui.ru/login?next=%2F" ]]
add_check "public / redirects to /login"

public_login_code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 https://admin.komui.ru/login)"
[[ "$public_login_code" == "200" ]]
add_check "public /login 200"

rm -rf "$build_dir"
if cleanup_old_releases; then
  add_check "release retention cleanup"
else
  log "WARNING: release retention cleanup failed"
  add_check "release retention cleanup warning"
fi
if cleanup_npm_cache; then
  add_check "npm cache cleanup"
else
  log "WARNING: npm cache cleanup failed"
  add_check "npm cache cleanup warning"
fi
post_free_mb="$(disk_free_mb)"
log "disk free after post-deploy cleanup: ${post_free_mb}MiB (min ${min_free_mb}MiB)"
if (( post_free_mb < min_free_mb )); then
  log "WARNING: disk free is below threshold after deploy"
  add_check "disk free warning ${post_free_mb}MiB"
else
  add_check "disk free ${post_free_mb}MiB"
fi
record_event "success" "GetoMerch admin deployed successfully"
log "deploy complete"
current_real="$(readlink -f "$current_link")"
if [[ "$current_real" != "$source_real" ]]; then
  log "cleaning deploy-source runtime artifacts"
  rm -rf "$source_dir/node_modules" "$source_dir/.next"
fi
