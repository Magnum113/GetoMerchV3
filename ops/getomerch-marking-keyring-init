#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

[[ "$EUID" -eq 0 ]] || {
  echo "Run with sudo." >&2
  exit 1
}

KEYRING_FILE="${GETOMERCH_MARKING_KEYRING_FILE:-/etc/getomerch/credentials/marking-keyring.json}"
KEYRING_DIR="$(dirname "$KEYRING_FILE")"

command -v install >/dev/null 2>&1 || {
  echo "ERROR: missing command: install" >&2
  exit 1
}
command -v openssl >/dev/null 2>&1 || {
  echo "ERROR: missing command: openssl" >&2
  exit 1
}

[[ ! -e "$KEYRING_FILE" ]] || {
  echo "ERROR: keyring already exists; rotate by adding a new version, never overwrite it" >&2
  exit 1
}

install -d -m 0700 -o root -g root "$KEYRING_DIR"
temporary="$(mktemp "$KEYRING_DIR/.marking-keyring.XXXXXX")"
encryption_key="$(openssl rand -base64 32)"
hmac_key="$(openssl rand -base64 32)"

printf '%s\n' \
  '{' \
  '  "currentEncryptionKeyVersion": 1,' \
  '  "encryptionKeys": {' \
  "    \"1\": \"$encryption_key\"" \
  '  },' \
  '  "currentHmacKeyVersion": 1,' \
  '  "hmacKeys": {' \
  "    \"1\": \"$hmac_key\"" \
  '  }' \
  '}' > "$temporary"

install -m 0600 -o root -g root "$temporary" "$KEYRING_FILE"
rm -f "$temporary"
unset encryption_key hmac_key

printf 'Created %s with mode 0600. Back it up encrypted and off-host before use.\n' \
  "$KEYRING_FILE"
