# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://bkxpzfnglihxpbnhtjjq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only Supabase BFF. Не использовать префикс NEXT_PUBLIC для секретных ключей.
# GETOMERCH_SUPABASE_URL можно не задавать, если он совпадает с NEXT_PUBLIC_SUPABASE_URL.
# На переходном этапе BFF умеет читать через anon fallback, но для закрытия RLS нужен
# service role или отдельный ограниченный серверный ключ.
# GETOMERCH_SUPABASE_URL=https://bkxpzfnglihxpbnhtjjq.supabase.co
# GETOMERCH_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# GETOMERCH_SUPABASE_SERVER_KEY=your_restricted_server_key_here

# Целевой локальный PostgreSQL после server migration. На текущем этапе
# production service этот env еще не подключает. Не использовать NEXT_PUBLIC.
# GETOMERCH_DATABASE_URL=postgresql://getomerch_app:secret@127.0.0.1:5432/getomerch_production?application_name=getomerch-admin&sslmode=disable
# GETOMERCH_DATABASE_SSL=false
# GETOMERCH_DATABASE_POOL_MAX=4
# Переходные flags миграции. До production cutover оба источника остаются supabase.
# GETOMERCH_DB_READ_SOURCE=supabase
# GETOMERCH_DB_WRITE_SOURCE=supabase
# GETOMERCH_DB_SHADOW_COMPARE=false
# Строгий режим нужен только в rehearsal/CI: несовпадение ответов завершает запрос ошибкой.
# GETOMERCH_DB_SHADOW_COMPARE_STRICT=false
# Разрешается только на одноразовой stage-7/stage-9 БД с именем
# getomerch_stage7_* или getomerch_stage9_*.
# Никогда не включать в production.
# GETOMERCH_DB_ALLOW_FAULT_INJECTION=false

# Фоновые задания Ozon. Все значения server-only, без NEXT_PUBLIC.
# Внутренний token нужен только для доверенных timers/service calls; UI работает
# через admin session. Сгенерировать: openssl rand -base64 48
# GETOMERCH_INTERNAL_SERVICE_TOKEN=replace_with_long_random_token
# GETOMERCH_WORKER_POLL_MS=2000
# GETOMERCH_WORKER_HEARTBEAT_MS=10000
# GETOMERCH_WORKER_STALE_SECONDS=120
# GETOMERCH_JOB_RETENTION_DAYS=30
# GETOMERCH_DATABASE_APPLICATION_NAME=getomerch-admin

# Управляемый режим обслуживания. При read_only UI и все mutation/job routes
# блокируют записи с HTTP 503; login, чтение и health остаются доступны.
# GETOMERCH_MAINTENANCE_MODE=off
# GETOMERCH_MAINTENANCE_REASON=Перенос рабочей базы данных

# Ozon Seller API. Поддерживается историческое имя OZON_CLIEN_ID и корректное
# OZON_CLIENT_ID; достаточно задать одно из них.
# OZON_CLIENT_ID=your_ozon_client_id
# OZON_API_KEY=your_ozon_api_key
# GETOMERCH_OZON_API_BASE_URL и GETOMERCH_ALLOW_OZON_BASE_URL_OVERRIDE разрешены
# только для локального mock-сервера в одноразовых тестах и запрещены в production.

# Komui API. В UI можно переключать prod/stage без перезаписи .env.
KOMUI_MIGRATION_API_BASE_URL=https://komui.ru/api
KOMUI_ADMIN_API_TOKEN=your_admin_token_here
KOMUI_PROD_API_BASE_URL=https://komui.ru/api
KOMUI_STAGE_API_BASE_URL=https://stage.komui.ru/api
# Если токены отличаются, задай target-specific значения:
# KOMUI_PROD_ADMIN_API_TOKEN=prod_admin_token_here
# KOMUI_STAGE_ADMIN_API_TOKEN=stage_admin_token_here

# Нужен только для stage. На production URL не отправляется.
# KOMUI_STAGE_BASIC_AUTH=user:password

# Авторизация админки
# Hash format: pbkdf2_sha256$310000$salt$hash
# Generate: printf '%s' 'your-password' | node scripts/generate-admin-password-hash.mjs
ADMIN_AUTH_PASSWORD_HASH=pbkdf2_sha256$310000$replace_salt$replace_hash
ADMIN_AUTH_COOKIE_SECRET=replace_with_long_random_secret
ADMIN_AUTH_COOKIE_NAME=getomerch_admin_session
ADMIN_AUTH_SESSION_DAYS=60
